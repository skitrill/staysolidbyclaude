{%- comment -%}
  CATEGORIES — a numbered category index.
  Each row opens its collection in place; the products inside use the same
  product card as every other grid on the site (card-product snippet), so
  image boxes, titles and prices follow one system.
  Styles live in staysolid-system.css (section 9, "Category index").
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="ss-index page-width">
  <ol class="ss-index__list" role="list">
    {%- for collection in collections -%}
      <li class="ss-index__item">
        <button
          type="button"
          class="ss-index__row"
          aria-expanded="false"
          aria-controls="SsIndexPanel-{{ section.id }}-{{ forloop.index }}"
        >
          <span class="ss-index__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="ss-index__name">{{ collection.title | escape }}</span>
          <span class="ss-index__arrow" aria-hidden="true">&rarr;</span>
        </button>
        {%- assign ss_card_scope = section.id | append: '-' | append: forloop.index -%}
        <div class="ss-index__panel" id="SsIndexPanel-{{ section.id }}-{{ forloop.index }}" hidden>
          <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
            {%- for product in collection.products limit: 6 -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  show_quick_add: false,
                  section_id: ss_card_scope
                %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </li>
    {%- endfor -%}
  </ol>
</div>

<script>
  (function () {
    var index = document.currentScript.previousElementSibling;
    if (!index) return;
    index.addEventListener('click', function (event) {
      var row = event.target.closest('.ss-index__row');
      if (!row) return;
      var wasOpen = row.getAttribute('aria-expanded') === 'true';

      // one category open at a time
      index.querySelectorAll('.ss-index__row[aria-expanded="true"]').forEach(function (openRow) {
        openRow.setAttribute('aria-expanded', 'false');
        document.getElementById(openRow.getAttribute('aria-controls')).hidden = true;
      });

      if (!wasOpen) {
        row.setAttribute('aria-expanded', 'true');
        document.getElementById(row.getAttribute('aria-controls')).hidden = false;
      }
    });
  })();
</script>
