<style type="text/css">
  h2 {
    font-size: 8.8px;
  }
.social-icons-wrapper {
  display: flex;
  justify-content: center;
  gap: 0.7rem; /* slight gap between icons if needed */
  margin: 0 !important;
  padding: 0 !important;
}

.social-icon {
  width: 19px;
  height: 19px;
  display: inline-block;
  text-decoration: none;
  outline: none;
}

.social-icon svg {
  width: 100%;
  height: 100%;
  fill: #494848; /* muted grey */
  transition: fill 0.3s ease, transform 0.3s ease;
}

.social-icon:hover svg,
.social-icon:focus svg {
  fill: #000; /* supreme red */
  transform: scale(1.1);
}

/* remove any native outline/highlight */
.social-icon:focus,
.social-icon:hover {
  background-color: transparent !important;
  outline: none !important;
  box-shadow: none !important;
}

.password-header {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

#shopdatetime {
  margin-top: 0.5rem !important; /* adjust this value as needed */
}
.time-style {
  font-size: 1.04rem;
  color: #000;
  margin: 0 !important;
  padding: 0 !important;
}
.custom-menu-wrapper {
  margin-top: 0.5rem !important; /* bring links closer */
}
  .color-background-1.gradient,
.color-background-2.gradient {
  padding-top: 0 !important;
}
  font-size: 9.6px;
  font-family: inherit;
  text-align: center;
  letter-spacing: calc(0.4px + 0.03em);
  word-spacing: 0.5px;
  line-height: 1.4;
  margin: 0;
}

@media (max-width: 767px) {
  .password-header h2 {
    font-size: 9.6px; /* preserve same size on mobile */
  }
}
  .newsletter-modal {
  font-size: 9.6px;
  text-align: center;
  font-family: inherit;
  font-style: inherit;
  font-weight: inherit;
  letter-spacing: 0.04em;
  word-spacing: 0.01em;
  line-height: 1.4;
  margin: 0 auto;
  max-width: 90%;
  color: inherit;
  white-space: normal;
}
  .newsletter-modal {
  position: fixed;
  z-index: 9999;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.newsletter-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}

.newsletter-content {
  position: relative;
  z-index: 10000;
  background: var(--ss-bg, #f4f3ef);
  padding: 2rem;
  max-width: 90%;
  width: 400px;
  box-shadow: 0 0 20px rgba(0,0,0,0.2);
  text-align: center;
}

.close-btn {
  position: absolute;
  right: 1rem;
  top: 1rem;
  background: transparent;
  border: none;
  font-size: 1.6rem;
  cursor: pointer;
  color: #ED1D24 !important;
}
  .password-logo {
    max-width: {{ settings.logo_width }}px;
  }
.custom-menu-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  gap: 0 !important;
  padding: 0 !important;
}


.custom-menu-item {
  text-decoration: none;
  color: #000;
  font-size: 1.04rem;
  padding: 0.2rem 0.5rem;
  background-color: var(--ss-bg, #f4f3ef);
  transition: all 0.3s ease;
  width: fit-content;
  text-align: center;
}

.custom-menu-item:hover {
  background-color: var(--ss-bg, #f4f3ef);
  text-decoration: #000;
}

  .time-style {
    font-size: 1.04rem;
    color: #000;
    margin: 0.2rem 0 1rem;
    margin-top: 0.1rem;
    padding: 0.2rem 0.5rem;
  }

  .terms-link-wrapper {
    margin-top: 1rem;
    text-align: center;
  }

  .terms-link {
    text-decoration: none;
    color: #000;
    font-size: 1.04rem;
    padding: 0.2rem 0.5rem;
    background-color: var(--ss-bg, #f4f3ef);
    transition: all 0.3s ease;
    width: fit-content;
  }

  .terms-link:hover {
    color: var(--ss-bg, #f4f3ef);
  }
  /* tighten everything on password page */
.password-wrapper {
  padding: 0 !important;
  margin: 0 !important;
}

.password-header {
  padding: 0 !important;
  margin: 0 !important;
}

.password-header img,
.password-logo {
  margin-bottom: 0.2rem !important;
}

#shopdatetime {
  margin-top: 0.2rem !important;
  margin-bottom: 0.4rem !important;
}

.custom-menu-wrapper.vertical {
  margin-top: 0.3rem !important;
  margin-bottom: 0.3rem !important;
  gap: 0.3rem !important;
}

.custom-menu-item {
  padding: 0.2rem 0.5rem !important;
  font-size: 9.6px !important;
  line-height: 1 !important;
}

.social-icons-wrapper {
  margin-top: 0.5rem !important;
  margin-bottom: 0.2rem !important;
}

.terms-link-wrapper {
  margin-top: 0.4rem !important;
}

</style>
<div id="newsletter-modal" class="newsletter-modal" style="display: none;">
  <div class="newsletter-backdrop" onclick="closeNewsletterModal()"></div>
  <div class="newsletter-content">
    <button class="close-btn" onclick="closeNewsletterModal()">×</button>
    <h2>join our mailing list</h2>
    <p>stay in the loop — get all the latest drops, updates, and exclusive offers.</p>
    <form method="post" action="/contact#contact_form" accept-charset="UTF-8" class="contact-form">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input
        type="email"
        name="contact[email]"
        placeholder="email address"
        required
        style="font-family: inherit; background-color: black; color: var(--ss-bg, #f4f3ef); padding: 0.5rem; border: none; width: 100%;"
      >
      <button type="submit" style="align: center; margin-top: 1rem; background-color: #000; color: var(--ss-bg, #f4f3ef); border: none; padding: 0.5rem 1rem;">subscribe</button>
    </form>
  </div>
</div>
