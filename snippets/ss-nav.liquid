{%- comment -%}
  STAYSOLID floating navigation assembly.
  One fixed unit above all page content (rendered directly in <body>,
  outside any transformed ancestor, so content genuinely scrolls behind it):
    .ss-nav     the glass bar — global navigation
    .ss-return  a small glass tab hanging from its bottom-left corner —
                "go back one level"; shown on every screen except the rack
  They are siblings, not parent/child: a backdrop-filter inside another
  backdrop-filter can't see the page, so the tab would lose its glass.
  Behaviour (scroll compaction, legibility over dark content, the BAG count,
  the dark filled-BAG mode, RETURN in/out and history) lives in
  assets/ss-nav.js; styles in staysolid-system.css §4 and §16.
  IDs CustomMenuBagLink / CartBubble are kept: the cart and product form
  scripts update the BAG count through them.
{%- endcomment -%}
{%- liquid
  assign ss_return = true
  if request.page_type == 'index'
    assign ss_return = false
  endif

  comment
    where RETURN goes when there is no in-site history to step back through
  endcomment
  assign ss_return_url = routes.root_url
  case request.page_type
    when 'product'
      if collection
        assign ss_return_url = collection.url
      endif
    when 'collection'
      assign ss_return_url = '/pages/categories'
    when 'article'
      assign ss_return_url = blog.url
  endcase
-%}
<div class="ss-navbar" data-ss-navbar>
  <div class="ss-nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}" data-ss-nav>
    <div class="ss-nav__list">
      <a
        href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
        class="ss-nav__item"
        {% if request.page_type contains 'customers/' %}aria-current="page"{% endif %}
      ><span class="ss-nav__word">user</span></a>
      <a href="{{ routes.root_url }}" class="ss-nav__item"{% if request.page_type == 'index' %} aria-current="page"{% endif %}><span class="ss-nav__word">rack</span></a>
      <a href="/pages/categories" class="ss-nav__item"{% if request.path == '/pages/categories' %} aria-current="page"{% endif %}><span class="ss-nav__word">categories</span></a>
      <a href="/pages/lookboard" class="ss-nav__item"{% if request.path == '/pages/lookboard' %} aria-current="page"{% endif %}><span class="ss-nav__word">lookboard</span></a>
      <a
        href="{{ routes.cart_url }}"
        id="CustomMenuBagLink"
        class="ss-nav__item{% if cart.item_count > 0 %} custom-menu-item--bag{% endif %}"
        {% if request.page_type == 'cart' %}aria-current="page"{% endif %}
      >
        <span class="ss-nav__word">bag</span><span id="CartBubble" class="ss-nav__count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- capture ss_return_inner -%}
    <svg class="ss-return__arrow" viewBox="0 0 12 10" aria-hidden="true" focusable="false"><path d="M5 1 1 5l4 4M1 5h10.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="square"/></svg><span>return</span>
  {%- endcapture -%}
  {%- if ss_return -%}
    <a href="{{ ss_return_url }}" class="ss-return" data-ss-return>{{ ss_return_inner }}</a>
  {%- else -%}
    {%- comment -%} the rack has no RETURN; this inert copy only plays the retract animation when arriving from a deeper screen {%- endcomment -%}
    <span class="ss-return" data-ss-return-ghost aria-hidden="true">{{ ss_return_inner }}</span>
  {%- endif -%}
</div>
