    <meta name="google-site-verification" content="{{ booster_config.google_verification_meta_tag }}" />
  {%- endif -%}
{%- endunless -%}

{%- comment -%}booster:desc:start{%- endcomment -%}
{%- comment -%}
  Same policy for the meta description: when meta is ON we always emit the
  Booster-optimized description (it wins, first in <head>); we gate only the
  non-optimized secondary-market and fallback emissions so they don't duplicate
  the theme's own description.
{%- endcomment -%}
{%- if ba_secondary_market -%}
  {%- comment -%} Secondary market: serve the native translated description untouched, unless the theme already emits its own. {%- endcomment -%}
  {%- unless booster_config.theme_has_native_desc -%}<meta name="description" content="{{ page_description | strip | strip_newlines | escape_once }}" />{%- endunless -%}
{%- elsif booster_desc != blank -%}
  {%- assign formatted_price = product.variants[0].price | money -%}
  {%- assign booster_desc = booster_desc | replace: "[description]", booster_item.description -%}
  {%- assign booster_desc = booster_desc | replace : "[price]", formatted_price -%}
  {%- assign booster_desc = booster_desc | replace: "[product_vendor]", booster_item.vendor -%}
  {%- assign booster_desc = booster_desc | replace: "[product_type]", booster_item.type -%}
  {%- assign booster_desc = booster_desc | replace : "[shop_name]", shop.name -%}
  {%- assign booster_desc = booster_desc | replace: "[title]", booster_item.title -%}
  {%- assign booster_desc = booster_desc | replace: "[content]", booster_item.content | strip_html -%}
  {%- assign booster_desc = booster_desc | replace: "[author]", booster_item.author -%}
  {%- assign booster_desc = booster_desc | strip_html | truncate: 250  -%}
  {%- assign booster_desc = booster_desc | replace : "[shopify_seo_description]", page_description | strip | strip_newlines | escape_once -%}
  <meta name="description" content="{{ booster_desc | strip | strip_newlines | escape_once }}" />
{%- else -%}
  {%- comment -%} No Booster-managed description (meta off): emit the default only when the theme is not already outputting its own. {%- endcomment -%}
  {%- unless booster_config.theme_has_native_desc -%}<meta name="description" content="{{ page_description | strip | strip_newlines | escape_once }}" />{%- endunless -%}
{%- endif -%}
{%- comment -%}booster:desc:end{%- endcomment -%}

