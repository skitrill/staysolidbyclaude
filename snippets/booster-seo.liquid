Breadcrumb Schema Markup (Home > Collection > Product)
{%- endcomment -%}
{%- assign bc_col = collection -%}
{%- if bc_col == blank -%}{%- assign bc_col = product.collections.first -%}{%- endif -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem","position": 1,"name": "Home","item": "{{ shop.secure_url }}"}
      {%- if bc_col != blank -%},
      {"@type": "ListItem","position": 2,"name": {{ bc_col.title | json }},"item": "{{ shop.secure_url }}{{ bc_col.url }}"},
      {"@type": "ListItem","position": 3,"name": {{ product.title | json }},"item": "{{ shop.secure_url }}{{ product.url }}"}
      {%- else -%},
      {"@type": "ListItem","position": 2,"name": {{ product.title | json }},"item": "{{ shop.secure_url }}{{ product.url }}"}
      {%- endif -%}
    ]
  }
</script>
{%- endif -%}
{%- elsif template.name == 'collection' or template == 'collection' -%}
{%- if booster_config.google_snippets_enabled -%}
{%- comment -%}
Collection (CollectionPage + ItemList) and Breadcrumb Schema Markup
{%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "url": "{{ shop.secure_url }}{{ collection.url }}",
    {%- if collection.description != blank -%}
    "description": {{ collection.description | strip_html | truncate: 500 | json }},
    {%- endif -%}
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {%- for product in collection.products limit: 50 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ product.title | json }},
          "url": "{{ shop.secure_url }}{{ product.url }}"
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem","position": 1,"name": "Home","item": "{{ shop.secure_url }}"},
      {"@type": "ListItem","position": 2,"name": {{ collection.title | json }},"item": "{{ shop.secure_url }}{{ collection.url }}"}
    ]
  }
</script>
{%- endif -%}
{%- elsif template.name == 'blog' or template == 'blog' -%}
{%- if booster_config.google_snippets_enabled -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "mainEntityOfPage": {"@type": "WebPage","@id": "{{ shop.secure_url }}{{ blog.url }}"},
    "publisher": {
      "@type": "Organization",
      "name": "{{ shop.name }}",
      "description": {{ shop.description | json }}
    },
    "url": "{{ shop.secure_url }}{{ blog.url }}",
    "name": "{{ blog.title }}"
  }
</script>
{%- endif -%}
{%- elsif template.name == 'article' or template == 'article' -%}
{%- if booster_config.google_snippets_enabled -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "mainEntityOfPage": {{ canonical_url | json }},
    "url": "{{ shop.secure_url }}{{ article.url }}",
    "author": {{ article.author | json }},
    "name": {{ article.title | json }},
    "publisher": {
      "@type": "Organization",
      "logo": {"@type": "ImageObject","url": "https:{{ 'logo.png' | asset_url }}"},
      "name": {{ shop.name | json }}
    },
    "headline": {{ article.title | json }},
    {%- if article.image -%}
      "image": {"@type": "ImageObject","width": 1024,"height": 1024,"url": "https:{{ article | img_url: '1024x1024' }}"},
    {%- else -%}
      "image": {"@type": "ImageObject","width": 1024,"height": 1024,"url": "https://cdn.shopify.com/s/images/admin/no-image-grande.gif"},
    {%- endif -%}
    "datePublished": "{{ article.published_at }}",
    "dateCreated": "{{ article.created_at }}",
    "dateModified": "{{ article.published_at }}",
    {%- if article.excerpt.size > 0 -%}"description": {{ article.excerpt | strip_html | json }} {%- else -%}"description": {{ article.content | strip_html | json }} {%- endif -%},"articleBody": {{ article.content | strip_html | json }}
  }
</script>
{%- endif -%}
{%- elsif template == '404' -%}
<script type="text/javascript">
  var http = new XMLHttpRequest();

  http.open('POST', "/apps/seo-optimizer/api/track_broken_links", true);
  http.setRequestHeader('Content-type', 'application/json');

  http.onreadystatechange = function () {
     if (http.readyState === 4 && http.status === 200) {
       console.log('sent to tracking');
     }
  };

  var currentTime = (new Date().getTime() / 1000);
  var data = JSON.stringify({
    path: location.pathname,
    time: currentTime
  });

  http.send(data);
</script>
{%- endif -%}

{%- comment -%}
FAQ (FAQPage) Schema Markup. Booster does NOT author FAQ content; it marks up an
FAQ list the store already maintains in a metafield, so the merchant's Q&A can
feed AI answer engines (ChatGPT, Perplexity, Google AI Overviews) as machine-
readable Q&A. Reads
`custom.faqs` on the current product / collection / page / article -- a list
(metaobject list or JSON) whose entries each expose `question` and `answer`.
Fully safe: if the metafield is absent or the shape doesn't match, it emits
nothing (no empty or malformed FAQPage). Gated on google_snippets_enabled like
all other Booster schema.
{%- endcomment -%}
{%- if booster_config.google_snippets_enabled -%}
  {%- assign booster_faqs = blank -%}
  {%- if template.name == 'product' or template == 'product' -%}
    {%- assign booster_faqs = product.metafields.custom.faqs.value -%}
  {%- elsif template.name == 'collection' or template == 'collection' -%}
    {%- assign booster_faqs = collection.metafields.custom.faqs.value -%}
  {%- elsif template.name == 'page' or template == 'page' -%}
    {%- assign booster_faqs = page.metafields.custom.faqs.value -%}
  {%- elsif template.name == 'article' or template == 'article' -%}
    {%- assign booster_faqs = article.metafields.custom.faqs.value -%}
  {%- endif -%}
  {%- if booster_faqs != blank and booster_faqs.size > 0 -%}
    {%- assign booster_faq_count = 0 -%}
    {%- for faq in booster_faqs -%}{%- if faq.question != blank and faq.answer != blank -%}{%- assign booster_faq_count = booster_faq_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if booster_faq_count > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign booster_faq_i = 0 -%}
      {%- for faq in booster_faqs -%}
        {%- if faq.question != blank and faq.answer != blank -%}
          {%- assign booster_faq_i = booster_faq_i | plus: 1 -%}
          {
            "@type": "Question",
            "name": {{ faq.question | strip_html | json }},
            "acceptedAnswer": {"@type": "Answer","text": {{ faq.answer | strip_html | json }}}
          }{%- unless booster_faq_i == booster_faq_count -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
<!-- end of Booster Apps SEO -->
