    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": "{{ shop.secure_url }}",
    "potentialAction": {
      "@type": "SearchAction",
      "query-input": "required name=query",
      "target": "{{ shop.secure_url }}/search?q={query}"
