<!-- force status bar color across all platforms -->
    <meta name="theme-color" content="#faf9f6">

<!-- iOS Safari -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

<!-- Windows Phone -->
    <meta name="msapplication-navbutton-color" content="#faf9f6">

<!-- Android Chrome + Samsung Internet -->
    <meta name="application-name" content="stww.ws">
    <meta name="msapplication-TileColor" content="#faf9f6">
    <meta name="msapplication-TileColor" content="#faf9f6">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="black">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    
<style>
  .variant-picker,
.product__info-container .product-form__input {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}
  /* lowercase everything */
* {
  text-transform: uppercase !important;
}
.select {
  width: 160px !important; /* adjust as needed */
  max-width: 100%;
}
.select__select {
  width: 100%;
  font-size: 11.2px;
  padding: 6px 10px;
  border: 1px solid #000;
  background: transparent;
}

/* Fix quantity container alignment */
.quantity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 140px;
  border: 1px solid #000;
  padding: 4px 6px;
  background: transparent;
}

.quantity__button {
  width: 20px;
  height: 20px;
  border: none;
  background: none;
  font-size: 14.4px;
  line-height: 1;
  padding: 0;
}

}
quantity-input,
.quantity,
.cart-quantity {
  max-height: 28px !important;
  font-size: 8.8px !important;
}

/* Ensure padding is consistent on product sections */
.section-template--17254420938946__main-padding {
  padding: 20px 15px !important;
}

/* Responsive fixes */
@media screen and (max-width: 750px) {
  .product {
    grid-template-columns: 1fr !important;
  }
  .select, .quantity {
    width: 100% !important;
  }
}

body, h1, h2, h3, h4, h5, h6,
p, span, a, label, li, th, td,
button, input, select, option, strong,
.caption, .title, .product__description,
.list-menu__item, .menu-link,
.footer__copyright, .link {
  text-transform: uppercase !important;
}
/* current prices */
.price-item,
.price-item--regular,
.price--end,
.product-option,
[class*="price"]:not(s):not(.cart-item__old-price) {
  color: #b8860b !important; /* dark yellow */
  font-family: 'Source Code Pro', monospace !important;
  font-size: 8px !important;
  font-weight: 600 !important;
  letter-spacing: 0em !important;
}

/* discounted prices (struck-through) */
.cart-item__old-price,
s,
s.price-item {
  color: #8f8d8d !important; /* soft ash gray */
  font-family: 'Source Code Pro', monospace !important;
  font-size: 8px !important;
  font-weight: 400 !important;
  letter-spacing: 0.01em !important;
  text-decoration: line-through !important;
}
</style>



