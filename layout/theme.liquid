  <script>
  document.addEventListener("DOMContentLoaded", function () {
    const body = document.body;

    // check for saved preference
    if (localStorage.getItem("darkMode") === "true") {
      body.classList.add("dark-mode");
    }

    // toggle dark mode
    const toggle = document.getElementById("darkModeToggle");
    if (toggle) {
      toggle.addEventListener("click", () => {
        body.classList.toggle("dark-mode");
        const isDark = body.classList.contains("dark-mode");
        localStorage.setItem("darkMode", isDark);
      });
    }
  });
</script>
    {% if template.name == 'product' %}
  <script>
    (function() {
      const productHandle = {{ product.handle | json }};
      const maxItems = 2;
      let recent = JSON.parse(localStorage.getItem('recentlyViewed')) || [];

      recent = recent.filter(handle => handle !== productHandle);
      recent.unshift(productHandle);

      if (recent.length > maxItems) recent = recent.slice(0, maxItems);
      localStorage.setItem('recentlyViewed', JSON.stringify(recent));
    })();
  </script>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('ajaxProduct:added', function (event) {
      updateCartCount();
    });

    function updateCartCount() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const cartCount = cart.item_count;
          const cartBubble = document.getElementById('CartBubble');
          if (cartCount > 0) {
            if (cartBubble) {
              cartBubble.textContent = `(${cartCount})`;
              cartBubble.setAttribute('data-cart-count', cartCount);
            } else {
              const bagLink = document.querySelector('a[href*="/cart"]');
              if (bagLink) {
                const span = document.createElement('span');
                span.id = 'CartBubble';
                span.setAttribute('data-cart-count', cartCount);
                span.textContent = `(${cartCount})`;
                span.style.marginLeft = '0.3rem';
                bagLink.appendChild(span);
              }
            }
          }
        });
    }
    // also hook into native Shopify events
    document.body.addEventListener('product:added', updateCartCount);
  });
</script>

