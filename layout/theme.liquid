      /* center-align country selector */
.localization-form {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}

/* container holding the form */
.footer__localization,
.shopify-section-footer {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

main {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

footer {
  margin-top: auto;
}

main {
  flex: 1;
}
      
/* fix: center the selector button exactly with header */
.localization-form__select,
.disclosure__button {
  margin: 0 auto;
}
/* center the localization form */
.footer__column.footer__localization {
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  flex-direction: column;
  margin-top: 2rem;
  text-transform: uppercase;
  font-size: 9.6px;
}

/* center text and dropdown */
.footer__column.footer__localization h2,
.footer__column.footer__localization .disclosure__button {
  margin-left: 0;
  text-align: center;
}

/* dropdown adjustments */
.footer__column.footer__localization .disclosure__button {
  width: auto;
  background-color: transparent;
  border: 1px solid #000;
  padding: 0.3rem 1rem;
  transition: all 0.2s ease-in-out;
  color: #000;
}

/* hover effect */
.footer__column.footer__localization .disclosure__button:hover,
.footer__column.footer__localization .disclosure__link:hover {
  background-color: #000;
  color: #fff;
}

/* update button centered */
.footer__column.footer__localization .button--tertiary {
  margin-top: 0.5rem;
  align-self: center;
  background-color: transparent;
  border: 1px solid #000;
  color: #000;
  transition: all 0.2s ease-in-out;
  padding: 0.3rem 1rem;
}

/* hover effect for update button */
.footer__column.footer__localization .button--tertiary:hover {
  background-color: #000;
  color: #fff;
}

/* dropdown list hover effect */
.footer__column.footer__localization .disclosure__link {
  transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
}

/* consistent font and size */
.footer__column.footer__localization *,
.footer__column.footer__localization select,
.footer__column.footer__localization button {
  font-size: 10.4px !important;
  text-transform: uppercase !important;
}
      /* dropdown list items */
.disclosure__item {
  background-color: #000 !important;
}
.disclosure__item a,
.disclosure__item span {
  color: #faf9f6 !important;
}

/* dropdown menu background */
.disclosure__list {
  background-color: #000 !important;
}

/* selected country container (before dropdown opens) */
.disclosure__button,
.localization-form__select {
  background-color: #000 !important;
  color: #faf9f6 !important;
  border: none !important;
}

/* optional: smooth border radius */
.disclosure__button,
.localization-form__select,
.disclosure__item {
  border-radius: 6px;
}
.footer__localization p {
  text-align: center;
  margin-left: auto;
  margin-right: auto;
  width: fit-content;
}
</style>
   <style>
/* snappy, immediate feel site-wide */
* {
  transition: all 0.12s cubic-bezier(0.2, 0, 0.2, 1) !important;
  backface-visibility: hidden;
  transform-style: preserve-3d;
}

/* page load animation */
body {
  animation: pageZoom 0.4s ease-out forwards;
  opacity: 0;
}

/* waving flag entry */
@keyframes pageZoom {
  0% {
    transform: scale(0.98) rotateX(5deg) rotateY(-5deg);
    opacity: 0;
  }
  100% {
    transform: scale(1) rotateX(0) rotateY(0);
    opacity: 1;
  }
}

/* zoom-in menu or modal effect */
.zoom-animate {
  animation: zoomIn 0.3s ease-in-out forwards;
}
@keyframes zoomIn {
  0% {
    transform: scale(0.9);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
/* smooth fade on nav/menu popups */
.fade-in {
  animation: fadeIn 0.25s ease forwards;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
